(set-option :timeout 15000)
(declare-datatype Endian ((HostLittleEndian) (HostBigEndian)))
(declare-const pc_in (_ BitVec 128))
(declare-const endian_in Endian)
(declare-const r1_in (_ BitVec 64))
(declare-const r2_in (_ BitVec 64))
(declare-const r1_out (_ BitVec 64))
(declare-const r2_out (_ BitVec 64))
(declare-const pc_out (_ BitVec 128))
(declare-const endian_out Endian)
(define-fun isa () Bool
  (and true (= endian_in HostLittleEndian) (= endian_out endian_in) (= r1_out r1_in) (= r2_out (bvadd r1_in (_ bv4 64))) (= pc_out (bvadd pc_in (_ bv2 128)))))
(define-fun baseline () Bool
  (exists ((b_r2_in (_ BitVec 64)) (b_pc_in (_ BitVec 128))) (exists ((A_v0 (_ BitVec 64)) (A_v1 (_ BitVec 128))) (let ((A_v2 (bvadd A_v1 #x00000000000000000000000000000001))) (and true (exists ((B_v0 (_ BitVec 64)) (B_v4 (_ BitVec 128))) (let ((B_v1 ((_ zero_extend 64) B_v0))) (let ((B_v2 (bvadd B_v1 #x00000000000000000000000000000004))) (let ((B_v3 ((_ extract 63 0) B_v2))) (let ((B_v5 (bvadd B_v4 #x00000000000000000000000000000001))) (and true (and true (= b_pc_in A_v2) (= b_r2_in A_v0) (= r1_out r1_in) (= r2_out B_v3) (= pc_out B_v5) (= endian_out endian_in)) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= b_r2_in B_v0) (= b_pc_in B_v4))))))) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= r1_in A_v0) (= pc_in A_v1))))))
(define-fun normalized () Bool
  (exists ((A_v0 (_ BitVec 64)) (A_v1 (_ BitVec 128))) (let ((A_v2 (bvadd A_v1 #x00000000000000000000000000000001))) (and true (let ((B_v0 A_v0)) (let ((B_v4 A_v2)) (let ((B_v1 ((_ zero_extend 64) B_v0))) (let ((B_v2 (bvadd B_v1 #x00000000000000000000000000000004))) (let ((B_v3 ((_ extract 63 0) B_v2))) (let ((B_v5 (bvadd B_v4 #x00000000000000000000000000000001))) (and true (and true (= r1_out r1_in) (= r2_out B_v3) (= pc_out B_v5) (= endian_out endian_in)) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= A_v0 B_v0) (= A_v2 B_v4)))))))) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= r1_in A_v0) (= pc_in A_v1)))))
(define-fun renamed () Bool
  (exists ((A_v0 (_ BitVec 64)) (A_v1 (_ BitVec 128))) (let ((A_v2 (bvadd A_v1 #x00000000000000000000000000000001))) (and true (let ((B_v6 A_v0)) (let ((B_v10 A_v2)) (let ((B_v7 ((_ zero_extend 64) B_v6))) (let ((B_v8 (bvadd B_v7 #x00000000000000000000000000000004))) (let ((B_v9 ((_ extract 63 0) B_v8))) (let ((B_v11 (bvadd B_v10 #x00000000000000000000000000000001))) (and true (and true (= r1_out r1_in) (= r2_out B_v9) (= pc_out B_v11) (= endian_out endian_in)) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= A_v0 B_v6) (= A_v2 B_v10)))))))) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= r1_in A_v0) (= pc_in A_v1)))))
(define-fun missing () Bool
  (exists ((b_r2_in (_ BitVec 64)) (b_pc_in (_ BitVec 128))) (exists ((A_v0 (_ BitVec 64)) (A_v1 (_ BitVec 128))) (let ((A_v2 (bvadd A_v1 #x00000000000000000000000000000001))) (and true (exists ((B_v0 (_ BitVec 64)) (B_v4 (_ BitVec 128))) (let ((B_v1 ((_ zero_extend 64) B_v0))) (let ((B_v2 (bvadd B_v1 #x00000000000000000000000000000004))) (let ((B_v3 ((_ extract 63 0) B_v2))) (let ((B_v5 (bvadd B_v4 #x00000000000000000000000000000001))) (and true (and true (= b_pc_in A_v2) (= r1_out r1_in) (= r2_out B_v3) (= pc_out B_v5) (= endian_out endian_in)) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= b_r2_in B_v0) (= b_pc_in B_v4))))))) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= r1_in A_v0) (= pc_in A_v1))))))
(define-fun wrong_b () Bool
  (exists ((b_r2_in (_ BitVec 64)) (b_pc_in (_ BitVec 128))) (exists ((A_v0 (_ BitVec 64)) (A_v1 (_ BitVec 128))) (let ((A_v2 (bvadd A_v1 #x00000000000000000000000000000001))) (and true (exists ((B_v0 (_ BitVec 64)) (B_v4 (_ BitVec 128))) (let ((B_v1 ((_ zero_extend 64) B_v0))) (let ((B_v2 (bvadd B_v1 #x00000000000000000000000000000004))) (let ((B_v3 ((_ extract 63 0) B_v2))) (let ((B_v5 (bvadd B_v4 #x00000000000000000000000000000001))) (and true (and true (= b_pc_in A_v2) (= B_v3 A_v0) (= r1_out r1_in) (= r2_out B_v3) (= pc_out B_v5) (= endian_out endian_in)) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= b_r2_in B_v0) (= b_pc_in B_v4))))))) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= r1_in A_v0) (= pc_in A_v1))))))
(define-fun wrong_a () Bool
  (exists ((b_r2_in (_ BitVec 64)) (b_pc_in (_ BitVec 128))) (exists ((A_v0 (_ BitVec 64)) (A_v1 (_ BitVec 128))) (let ((A_v2 (bvadd A_v1 #x00000000000000000000000000000001))) (and true (exists ((B_v0 (_ BitVec 64)) (B_v4 (_ BitVec 128))) (let ((B_v1 ((_ zero_extend 64) B_v0))) (let ((B_v2 (bvadd B_v1 #x00000000000000000000000000000004))) (let ((B_v3 ((_ extract 63 0) B_v2))) (let ((B_v5 (bvadd B_v4 #x00000000000000000000000000000001))) (and true (and true (= b_pc_in A_v2) (= b_r2_in r2_in) (= r1_out r1_in) (= r2_out B_v3) (= pc_out B_v5) (= endian_out endian_in)) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= b_r2_in B_v0) (= b_pc_in B_v4))))))) (= endian_in HostLittleEndian) (= endian_in HostLittleEndian) (= r1_in A_v0) (= pc_in A_v1))))))
(echo "baseline implies ISA")
(push)
(assert (and baseline (not isa)))
(check-sat-using (then simplify qe-light smt))
(pop)
(echo "ISA implies baseline (total input coverage)")
(push)
(assert (and isa (not baseline)))
(check-sat-using (then simplify qe-light smt))
(pop)
(echo "baseline implies normalized")
(push)
(assert (and baseline (not normalized)))
(check-sat-using (then simplify qe-light smt))
(pop)
(echo "normalized implies baseline")
(push)
(assert (and normalized (not baseline)))
(check-sat-using (then simplify qe-light smt))
(pop)
(echo "renamed input changes the relation")
(push)
(assert (xor normalized renamed))
(check-sat-using (then simplify qe-light smt))
(pop)
(echo "missing r2 connection allows incorrect output")
(push)
(assert (and missing (distinct r2_out (bvadd r1_in (_ bv4 64)))))
(check-sat-using (then simplify qe-light smt))
(get-value (r1_in r2_in r2_out pc_in pc_out endian_in))
(pop)
(echo "B exit in place of B entry allows incorrect output")
(push)
(assert (and wrong_b (distinct r2_out (bvadd r1_in (_ bv4 64)))))
(check-sat-using (then simplify qe-light smt))
(get-value (r1_in r2_in r2_out pc_in pc_out endian_in))
(pop)
(echo "A entry in place of A exit allows incorrect output")
(push)
(assert (and wrong_a (distinct r2_out (bvadd r1_in (_ bv4 64)))))
(check-sat-using (then simplify qe-light smt))
(get-value (r1_in r2_in r2_out pc_in pc_out endian_in))
(pop)
